# Required Azure OpenAI resource URL, without /openai or /openai/v1.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com

# Text model deployment used by the travel agents.
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional: pin Azure CLI authentication to a specific tenant.
AZURE_TENANT_ID=

# Optional: enables live flight data; without it the app uses demo data.
AVIATIONSTACK_API_KEY=
