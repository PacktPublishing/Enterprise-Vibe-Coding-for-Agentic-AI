{
  "servers": {
    "mermaid-mcp": {
      "url": "https://mcp.mermaid.ai/mcp",
      "type": "http",
      "headers": {
        "Authorization": "${input:mermaid_authorization}"
      }
    },
    "microsoft/azure-devops-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "${input:ado_org}",
        "-d",
        "${input:ado_domain}"
      ],
      "gallery": "https://api.mcp.github.com",
      "version": "1.0.0"
    }
  },
  "inputs": [
    {
      "id": "mermaid_authorization",
      "type": "promptString",
      "description": "Mermaid MCP authorization token",
      "password": true
    },
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Azure DevOps organization name"
    },
    {
      "id": "ado_domain",
      "type": "promptString",
      "description": "Azure DevOps domain"
    }
  ]
}
